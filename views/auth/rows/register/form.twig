<main>
  <form method="post" id="register-form" action="{{ url('/auth/register/henan') }}">
    {{ csrf_field() }}

    <div class="input-group mb-3">
      <select name="school" id="school" class="form-control" required>
        <option value="" disabled{% if not user_data.school %} selected{% endif %}>
          {{ trans('Blessing\\HAuth::auth.select-school') }}
        </option>
        {% for key, value in schools %}
          <option value="{{ key }}"{% if user_data.school == key %} selected{% endif %}>{{ value }}</option>
        {% endfor %}
      </select>
      <div class="input-group-append">
        <div class="input-group-text">
          <span class="fa fa-graduation-cap"></span>
        </div>
      </div>
    </div>

    <div class="input-group mb-3">
      <input
        name="identification"
        id="identification"
        type="text"
        class="form-control"
        value="{{ user_data.identification }}"
        placeholder="{{ trans('Blessing\\HAuth::auth.identification') }}"
        autocomplete="username"
        required
      >
      <div class="input-group-append">
        <div class="input-group-text">
          <span class="fas fa-user"></span>
        </div>
      </div>
    </div>

    <div class="input-group mb-3">
      <input
        name="password"
        id="password"
        type="password"
        class="form-control"
        placeholder="{{ trans('Blessing\\HAuth::auth.password') }}"
        autocomplete="current-password"
        required
      >
      <div class="input-group-append">
        <div class="input-group-text">
          <span class="fas fa-key"></span>
        </div>
      </div>
    </div>

    <div class="input-group mb-3">
      <input
        name="site_password"
        id="site-password"
        type="password"
        class="form-control"
        placeholder="{{ trans('Blessing\\HAuth::auth.site-password') }}"
        autocomplete="new-password"
        minlength="8"
        maxlength="32"
        required
      >
      <div class="input-group-append">
        <div class="input-group-text">
          <span class="fas fa-lock"></span>
        </div>
      </div>
    </div>

    <div class="input-group mb-3">
      <input
        name="player_name"
        id="player-name"
        type="text"
        class="form-control"
        value="{{ user_data.player_name }}"
        placeholder="{{ trans('Blessing\\HAuth::auth.player-name') }}"
        autocomplete="off"
        required
      >
      <div class="input-group-append">
        <div class="input-group-text">
          <span class="fas fa-gamepad"></span>
        </div>
      </div>
    </div>

    {% if extra.recaptcha %}
      <input type="hidden" name="captcha" id="henan-captcha-token">
      <div
        class="g-recaptcha mb-3"
        data-sitekey="{{ extra.recaptcha }}"
        data-size="{{ extra.invisible ? 'invisible' : 'normal' }}"
        data-callback="henanCaptchaCompleted"
        data-expired-callback="henanCaptchaExpired"
      ></div>
    {% else %}
      <div class="input-group mb-3">
        <input
          name="captcha"
          type="text"
          class="form-control"
          placeholder="{{ trans('Blessing\\HAuth::auth.captcha') }}"
          autocomplete="off"
          required
        >
        <div class="input-group-append">
          <img
            src="{{ url('/auth/captcha') }}"
            alt="{{ trans('Blessing\\HAuth::auth.captcha') }}"
            title="{{ trans('Blessing\\HAuth::auth.change-captcha') }}"
            class="border rounded-right"
            style="height: 38px; cursor: pointer;"
            onclick="this.src='{{ url('/auth/captcha') }}?v=' + Date.now()"
          >
        </div>
      </div>
    {% endif %}

    {% if errors.any %}
      <div class="alert alert-warning">
        <i class="icon fas fa-exclamation-triangle mr-1"></i>
        {{ errors.first }}
      </div>
    {% endif %}

    {% if msg|length > 0 %}
      <div class="alert alert-warning">
        <i class="icon fas fa-exclamation-triangle mr-1"></i>
        {{ msg }}
      </div>
    {% endif %}

    <button type="submit" class="btn btn-primary btn-block mt-3">
      {{ trans('Blessing\\HAuth::auth.register.title') }}
    </button>

    <div class="d-flex justify-content-between mt-2">
      <a href="{{ url('/auth/register') }}">{{ trans('Blessing\\HAuth::auth.register.normal') }}</a>
      <a href="{{ url('/auth/login/henan') }}">{{ trans('Blessing\\HAuth::auth.register.login') }}</a>
    </div>
  </form>
</main>
