<main>
  <form method="post" id="login-form" action="{{ url('/auth/login/henan') }}">
    {{ csrf_field() }}
    <input name="fpVistorId" id="fpVistorId" type="hidden"/>

    <!-- auth_school -->
    <div class="input-group mb-3">
      <select name="school" id="school" class="form-control">
        {% for key, value in schools %}
        <option value={{key}}>{{value}}</option>
        {% endfor %}
      </select>
      <div class="input-group-append">
        <div class="input-group-text">
          <span class="fa fa-graduation-cap" />
        </div>
      </div>
    </div>
    <!-- HAuth-id -->
    <div class="input-group mb-3">
      <input name="identification" id="identification" type="text" class="form-control"
        placeholder="{{ trans('Blessing\\HAuth::auth.identification') }}">
      <div class="input-group-append">
        <div class="input-group-text">
          <span class="fas fa-user" />
        </div>
      </div>
    </div>
    <!-- password -->
    <div class="input-group mb-3">
      <input name="password" id="password" type="password" class="form-control"
        placeholder="{{ trans('Blessing\\HAuth::auth.password') }}">
      <div class="input-group-append">
        <div class="input-group-text">
          <span class="fas fa-key" />
        </div>
      </div>
    </div>

    <!-- player-name -->
    <div class="input-group mb-3">
      <input name="player_name" type="text" class="form-control"
        placeholder="{{ trans('Blessing\\HAuth::auth.player-name') }}">
      <div class="input-group-append">
        <div class="input-group-text">
          <span class="fas fa-gamepad" />
        </div>
      </div>
    </div>

    {% if errors.any %}
    <div class="alert alert-warning">
      <i class="icon fas fa-exclamation-triangle" style="display:contents;">
        {{ errors.first }}
      </i>
    </div>
    {% endif %}

    <!-- msg -->
    {% if msg|length>0 %}
    <div class="alert alert-warning">
      <i class="icon fas fa-exclamation-triangle" style="display:contents;">
        {{msg}}
      </i>
    </div>
    {% endif %}

    <button type="submit" class="btn btn-primary btn-block mt-3">
      {{ trans('Blessing\\HAuth::auth.login.title') }}
    </button>

    <div class="d-flex justify-content-between mt-2">
      <a href="{{ url('/auth/login') }}">返回普通登录</a>
      <a href="{{ url('/auth/register') }}">注册新账号</a>
    </div>
    
  </form>
</main>
