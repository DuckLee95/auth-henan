<main>
  <form method="post" id="login-form" action="{{ url('/auth/login/henan') }}">
    {{ csrf_field() }}

    <style>
      .school-select:required:invalid { color: #6c757d; }
      .school-select option { color: #495057; }
    </style>

    <div class="input-group mb-3">
      <select name="school" id="school" class="form-control school-select" autocomplete="off" required>
        <option value="" disabled hidden{% if not user_data.school %} selected{% endif %}>
          {{ trans('Blessing\\HAuth::auth.select-school') }}
        </option>
        {% for key, value in schools %}
          <option value="{{ key }}"{% if user_data.school == key %} selected{% endif %}>{{ value }}</option>
        {% endfor %}
      </select>
      <div class="input-group-append">
        <div class="input-group-text">
          <span class="fa fa-graduation-cap"></span>
        </div>
      </div>
    </div>

    <div class="input-group mb-3">
      <input
        name="identification"
        id="identification"
        type="text"
        class="form-control"
        value="{{ user_data.identification }}"
        placeholder="{{ trans('Blessing\\HAuth::auth.identification') }}"
        autocomplete="username"
        required
      >
      <div class="input-group-append">
        <div class="input-group-text">
          <span class="fas fa-user"></span>
        </div>
      </div>
    </div>

    <div class="input-group mb-3">
      <input
        name="password"
        id="password"
        type="password"
        class="form-control"
        placeholder="{{ trans('Blessing\\HAuth::auth.password') }}"
        autocomplete="current-password"
        required
      >
      <div class="input-group-append">
        <div class="input-group-text">
          <span class="fas fa-key"></span>
        </div>
      </div>
    </div>

    {% if errors.any %}
      <div class="alert alert-warning">
        <i class="icon fas fa-exclamation-triangle mr-1"></i>
        {{ errors.first }}
      </div>
    {% endif %}

    {% if msg|length > 0 %}
      <div class="alert alert-warning">
        <i class="icon fas fa-exclamation-triangle mr-1"></i>
        {{ msg }}
      </div>
    {% endif %}

    <button type="submit" class="btn btn-primary btn-block mt-3">
      {{ trans('Blessing\\HAuth::auth.login.title') }}
    </button>

    <div class="d-flex justify-content-between mt-2">
      <a href="{{ url('/auth/login') }}">{{ trans('Blessing\\HAuth::auth.login.normal') }}</a>
      <a href="{{ url('/auth/register/henan') }}">{{ trans('Blessing\\HAuth::auth.login.register') }}</a>
    </div>
  </form>
</main>
